{
  "name": "drug-dashboard-poc",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "build": "bun build src/index.ts --outdir dist --minify",
    "prisma:generate": "bunx prisma generate",
    "migrate": "bunx --bun prisma migrate deploy",
    "seed": "bunx --bun prisma db seed",
    "init:api": "bun run src/index.ts",
    "init:db": "bun run migrate && bun run seed",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage",
    "test:ui": "vitest --ui"
  },
  "dependencies": {
    "@prisma/adapter-mariadb": "^7.4.2",
    "@prisma/adapter-pg": "^7.4.2",
    "@prisma/client": "^7.4.2",
    "csv-parser": "^3.0.0",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "pg": "^8.20.0",
    "prisma": "^7.4.2"
  },
  "devDependencies": {
    "@types/bun": "^1.3.10",
    "@types/express": "^5.0.6",
    "@types/node": "^25.4.0",
    "@vitest/ui": "^1.0.4",
    "supertest": "^6.3.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vite": "^5.0.8",
    "vitest": "^1.0.4"
  },
  "prisma": {
    "seed": "bunx ts-node prisma/seed.ts"
  }
}